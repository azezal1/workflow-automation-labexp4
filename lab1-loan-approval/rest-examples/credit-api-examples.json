        },
        "body": {
          "applicantId": "APP-2024-002",
          "applicantName": "Jane Doe",
          "monthlyIncome": 3200,
          "requestedAmount": 18000,
          "employmentStatus": "FULL_TIME"
        }
      },
      "response": {

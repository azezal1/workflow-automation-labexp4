<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.4.0">
  <bpmn:process id="hospital-appointment-triage" name="Hospital Appointment Triage" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Appointment Request Received">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:userTaskForm_1" />
        <zeebe:userTaskForm id="userTaskForm_1">
          {
            "components": [
              {
                "label": "Patient Reference",
                "type": "textfield",
                "id": "Field_patientRef",
                "key": "patientRef",
                "validate": {
                  "required": true
                }
              },
              {
                "label": "Patient Name",
                "type": "textfield",
                "id": "Field_patientName",
                "key": "patientName",
                "validate": {
                  "required": true
                }
              },
              {
                "label": "Appointment Preference",
                "type": "textfield",
                "id": "Field_appointmentPreference",
                "key": "appointmentPreference",
                "description": "e.g., morning, afternoon, evening",
                "validate": {
                  "required": true
                }
              },
              {
                "label": "Symptoms Description",
                "type": "textarea",
                "id": "Field_symptomsDescription",
                "key": "symptomsDescription",
                "validate": {
                  "required": true
                }
              },
              {
                "label": "Urgency Indicators",
                "type": "textfield",
                "id": "Field_urgencyIndicators",
                "key": "urgencyIndicators",
                "description": "e.g., high-fever, chest-pain, minor",
                "validate": {
                  "required": true
                }
              }
            ],
            "type": "default",
            "id": "Form_AppointmentRequest",
            "executionPlatform": "Camunda Cloud",
            "executionPlatformVersion": "8.4.0",
            "exporter": {
              "name": "Camunda Modeler",
              "version": "5.20.0"
            },
            "schemaVersion": 12
          }
        </zeebe:userTaskForm>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_ValidateRegistration" name="Validate Registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-registration" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RegistrationValid" name="Registration Valid?" default="Flow_04">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Activity_ClassifyTriage" name="Classify Triage Category">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="triage-decision" resultVariable="triageCategory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_TriageCategory" name="Triage Category?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_UrgentAssessment</bpmn:outgoing>
      <bpmn:outgoing>Flow_PriorityReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_Routine</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_ImmediateHumanAssessment" name="Immediate Human Assessment">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="" candidateGroups="emergency-staff" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_UrgentAssessment</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_UrgentCaseHandled" name="Urgent Case Handled">
      <bpmn:incoming>Flow_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_CheckAvailabilityPriority" name="Check Appointment Availability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http" />
        <zeebe:taskHeaders>
          <zeebe:header key="url" value="http://localhost:8092/api/slots?preference={{appointmentPreference}}&amp;priority=high" />
          <zeebe:header key="method" value="GET" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:output source="=body.slots" target="availableSlots" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PriorityReview</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SlotAvailablePriority" name="Slot Available for Priority?" default="Flow_09">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_BookPriorityAppointment" name="Book Priority Appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="book-appointment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_PriorityBooked" name="Priority Appointment Booked">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_StaffReviewNoPrioritySlot" name="Staff Review - No Priority Slot">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="" candidateGroups="scheduling-staff" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_PriorityReviewed" name="Priority Case Reviewed">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_CheckAvailabilityRoutine" name="Check Appointment Availability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http" />
        <zeebe:taskHeaders>
          <zeebe:header key="url" value="http://localhost:8092/api/slots?preference={{appointmentPreference}}&amp;priority=routine" />
          <zeebe:header key="method" value="GET" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:output source="=body.slots" target="availableSlots" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Routine</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SlotAvailableRoutine" name="Slot Available for Routine?" default="Flow_14">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_BookRoutineAppointment" name="Book Routine Appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="book-appointment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_RoutineBooked" name="Routine Appointment Booked">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_StaffReviewNoRoutineSlot" name="Staff Review - No Routine Slot">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="" candidateGroups="scheduling-staff" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_RoutineReviewed" name="Routine Case Reviewed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_HandleInvalidRegistration" name="Handle Invalid Registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handle-registration-error" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_RegistrationFailed" name="Registration Failed">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Activity_ValidateRegistration" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Activity_ValidateRegistration" targetRef="Gateway_RegistrationValid" />
    <bpmn:sequenceFlow id="Flow_03" name="Valid" sourceRef="Gateway_RegistrationValid" targetRef="Activity_ClassifyTriage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=registrationValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" name="Invalid" sourceRef="Gateway_RegistrationValid" targetRef="Activity_HandleInvalidRegistration" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Activity_ClassifyTriage" targetRef="Gateway_TriageCategory" />
    <bpmn:sequenceFlow id="Flow_UrgentAssessment" name="Urgent Assessment" sourceRef="Gateway_TriageCategory" targetRef="Activity_ImmediateHumanAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "UrgentAssessment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PriorityReview" name="Priority Review" sourceRef="Gateway_TriageCategory" targetRef="Activity_CheckAvailabilityPriority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "PriorityReview"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Routine" name="Routine" sourceRef="Gateway_TriageCategory" targetRef="Activity_CheckAvailabilityRoutine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "Routine"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Activity_ImmediateHumanAssessment" targetRef="Event_UrgentCaseHandled" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Activity_CheckAvailabilityPriority" targetRef="Gateway_SlotAvailablePriority" />
    <bpmn:sequenceFlow id="Flow_08" name="Yes" sourceRef="Gateway_SlotAvailablePriority" targetRef="Activity_BookPriorityAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(availableSlots) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" name="No" sourceRef="Gateway_SlotAvailablePriority" targetRef="Activity_StaffReviewNoPrioritySlot" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_BookPriorityAppointment" targetRef="Event_PriorityBooked" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_StaffReviewNoPrioritySlot" targetRef="Event_PriorityReviewed" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_CheckAvailabilityRoutine" targetRef="Gateway_SlotAvailableRoutine" />
    <bpmn:sequenceFlow id="Flow_13" name="Yes" sourceRef="Gateway_SlotAvailableRoutine" targetRef="Activity_BookRoutineAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(availableSlots) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" name="No" sourceRef="Gateway_SlotAvailableRoutine" targetRef="Activity_StaffReviewNoRoutineSlot" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Activity_BookRoutineAppointment" targetRef="Event_RoutineBooked" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_StaffReviewNoRoutineSlot" targetRef="Event_RoutineReviewed" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Activity_HandleInvalidRegistration" targetRef="Event_RegistrationFailed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="hospital-appointment-triage">

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="ecommerce-order-process" name="E-Commerce Order Processing" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_ValidateOrder" />
    
    <bpmn:serviceTask id="Task_ValidateOrder" name="Validate Order and Check Inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ValidateOrder" targetRef="Gateway_StockCheck" />
    
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Stock Available?">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_StockAvailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_StockUnavailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_StockAvailable" name="Yes" sourceRef="Gateway_StockCheck" targetRef="Task_CalculatePriority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_StockUnavailable" name="No" sourceRef="Gateway_StockCheck" targetRef="Task_NotifyOutOfStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockAvailable = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:businessRuleTask id="Task_CalculatePriority" name="Calculate Order Priority (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="order-priority-decision" resultVariable="orderPriority" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StockAvailable</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CalculatePriority" targetRef="Task_ProcessPayment" />
    
    <bpmn:serviceTask id="Task_ProcessPayment" name="Process Payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ProcessPayment" targetRef="Gateway_PaymentStatus" />
    
    <bpmn:exclusiveGateway id="Gateway_PaymentStatus" name="Payment Success?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentSuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_PaymentSuccess" name="Success" sourceRef="Gateway_PaymentStatus" targetRef="Gateway_HighValue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "success"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_PaymentFailed" name="Failed" sourceRef="Gateway_PaymentStatus" targetRef="Task_HandlePaymentFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "failed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:exclusiveGateway id="Gateway_HighValue" name="High-Value Order?">
      <bpmn:incoming>Flow_PaymentSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_HighValue</bpmn:outgoing>
      <bpmn:outgoing>Flow_NormalOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_HighValue" name="Yes" sourceRef="Gateway_HighValue" targetRef="Task_ManualVerification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderTotal &gt;= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_NormalOrder" name="No" sourceRef="Gateway_HighValue" targetRef="Task_PrepareFulfilment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderTotal &lt; 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:userTask id="Task_ManualVerification" name="Manual Verification for High-Value Order">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="order-reviewer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighValue</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterVerification</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_AfterVerification" sourceRef="Task_ManualVerification" targetRef="Task_PrepareFulfilment" />
    
    <bpmn:serviceTask id="Task_PrepareFulfilment" name="Prepare Order for Fulfilment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="prepare-fulfilment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NormalOrder</bpmn:incoming>
      <bpmn:incoming>Flow_AfterVerification</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSuccess" sourceRef="Task_PrepareFulfilment" targetRef="EndEvent_Success" />
    
    <bpmn:serviceTask id="Task_HandlePaymentFailure" name="Handle Payment Failure">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handle-payment-failure" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPaymentFailedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPaymentFailedEnd" sourceRef="Task_HandlePaymentFailure" targetRef="EndEvent_PaymentFailed" />
    
    <bpmn:serviceTask id="Task_NotifyOutOfStock" name="Notify Customer - Out of Stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-out-of-stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StockUnavailable</bpmn:incoming>
      <bpmn:outgoing>Flow_ToOutOfStockEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToOutOfStockEnd" sourceRef="Task_NotifyOutOfStock" targetRef="EndEvent_OutOfStock" />
    
    <bpmn:endEvent id="EndEvent_Success" name="Order Fulfilled">
      <bpmn:incoming>Flow_ToSuccess</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:endEvent id="EndEvent_PaymentFailed" name="Payment Failed">
      <bpmn:incoming>Flow_ToPaymentFailedEnd</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:endEvent id="EndEvent_OutOfStock" name="Out of Stock">
      <bpmn:incoming>Flow_ToOutOfStockEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ecommerce-order-process">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="157" y="202" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_ValidateOrder_di" bpmnElement="Task_ValidateOrder">

        <di:waypoint x="540" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="464" y="303" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="640" y="90" />

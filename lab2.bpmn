      <bpmndi:BPMNShape id="Task_ProcessPayment_di" bpmnElement="Task_ProcessPayment">
        <dc:Bounds x="700" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_PaymentStatus_di" bpmnElement="Gateway_PaymentStatus" isMarkerVisible="true">
        <dc:Bounds x="860" y="65" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="858" y="41" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_HandlePaymentFailure_di" bpmnElement="Task_HandlePaymentFailure">
        <dc:Bounds x="970" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_HighValue_di" bpmnElement="Gateway_HighValue" isMarkerVisible="true">
        <dc:Bounds x="995" y="20" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="989" y="0" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_ManualVerification_di" bpmnElement="Task_ManualVerification">
        <dc:Bounds x="1110" y="5" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_PrepareFulfilment_di" bpmnElement="Task_PrepareFulfilment">
        <dc:Bounds x="1270" y="70" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="1432" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1412" y="135" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_PaymentFailed_di" bpmnElement="EndEvent_PaymentFailed">
        <dc:Bounds x="1132" y="172" width="36" height="36" />

        <di:waypoint x="970" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="902" y="173" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_HighValue_di" bpmnElement="Flow_HighValue">
        <di:waypoint x="1045" y="45" />
        <di:waypoint x="1110" y="45" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1068" y="28" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_NormalOrder_di" bpmnElement="Flow_NormalOrder">
        <di:waypoint x="1020" y="70" />
        <di:waypoint x="1020" y="110" />
        <di:waypoint x="1270" y="110" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1029" y="93" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_AfterVerification_di" bpmnElement="Flow_AfterVerification">
        <di:waypoint x="1210" y="45" />
        <di:waypoint x="1240" y="45" />
        <di:waypoint x="1240" y="110" />
        <di:waypoint x="1270" y="110" />

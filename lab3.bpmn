      <bpmndi:BPMNEdge id="Flow_StaffRejected_di" bpmnElement="Flow_StaffRejected">
        <di:waypoint x="895" y="335" />
        <di:waypoint x="895" y="440" />
        <di:waypoint x="1010" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="904" y="423" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToBooked_di" bpmnElement="Flow_ToBooked">
        <di:waypoint x="1110" y="150" />
        <di:waypoint x="1172" y="150" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToUrgentEnd_di" bpmnElement="Flow_ToUrgentEnd">
        <di:waypoint x="810" y="470" />
        <di:waypoint x="872" y="470" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToRejected_di" bpmnElement="Flow_ToRejected">
        <di:waypoint x="1110" y="440" />
        <di:waypoint x="1172" y="440" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
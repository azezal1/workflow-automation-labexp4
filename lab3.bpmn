<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="hospital-appointment-process" name="Hospital Appointment and Patient Triage" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Appointment Request Received">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_ValidateRegistration" />
    
    <bpmn:serviceTask id="Task_ValidateRegistration" name="Validate Patient Registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-patient-registration" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ValidateRegistration" targetRef="Task_TriageClassification" />
    
    <bpmn:businessRuleTask id="Task_TriageClassification" name="Triage Classification (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="triage-decision" resultVariable="triageCategory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_TriageClassification" targetRef="Gateway_TriageCategory" />
    
    <bpmn:exclusiveGateway id="Gateway_TriageCategory" name="Triage Category?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_Routine</bpmn:outgoing>
      <bpmn:outgoing>Flow_PriorityReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_Urgent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_Routine" name="Routine" sourceRef="Gateway_TriageCategory" targetRef="Task_CheckAvailability" default="true">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "Routine"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_PriorityReview" name="Priority Review" sourceRef="Gateway_TriageCategory" targetRef="Task_StaffReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "Priority Review"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_Urgent" name="Urgent Assessment" sourceRef="Gateway_TriageCategory" targetRef="Task_UrgentAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "Urgent Assessment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:serviceTask id="Task_CheckAvailability" name="Check Appointment Availability (REST API)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="https://jsonplaceholder.typicode.com/users/1" target="url" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={&#10;  myResponseBody: response.body,&#10;  slotsAvailable: if response.body.id != null then true else false&#10;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Routine</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CheckAvailability" targetRef="Gateway_AvailabilityCheck" />
    
    <bpmn:exclusiveGateway id="Gateway_AvailabilityCheck" name="Slots Available?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_SlotsAvailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoSlots</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_SlotsAvailable" name="Yes" sourceRef="Gateway_AvailabilityCheck" targetRef="Task_BookAppointment" default="true">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotsAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_NoSlots" name="No" sourceRef="Gateway_AvailabilityCheck" targetRef="Task_StaffReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotsAvailable = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:userTask id="Task_StaffReview" name="Staff Review for Priority or No-Slot Cases">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="medical-staff" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PriorityReview</bpmn:incoming>
      <bpmn:incoming>Flow_NoSlots</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterStaffReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_AfterStaffReview" sourceRef="Task_StaffReview" targetRef="Gateway_StaffDecision" />
    
    <bpmn:exclusiveGateway id="Gateway_StaffDecision" name="Staff Decision?">
      <bpmn:incoming>Flow_AfterStaffReview</bpmn:incoming>
      <bpmn:outgoing>Flow_StaffApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_StaffRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_StaffApproved" name="Approved" sourceRef="Gateway_StaffDecision" targetRef="Task_BookAppointment" default="true">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=staffDecision = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_StaffRejected" name="Rejected" sourceRef="Gateway_StaffDecision" targetRef="Task_NotifyRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=staffDecision = "Rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:serviceTask id="Task_BookAppointment" name="Book Appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="book-appointment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotsAvailable</bpmn:incoming>
      <bpmn:incoming>Flow_StaffApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBooked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToBooked" sourceRef="Task_BookAppointment" targetRef="EndEvent_Booked" />
    
    <bpmn:userTask id="Task_UrgentAssessment" name="Urgent Assessment by Medical Staff">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="emergency-staff" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Urgent</bpmn:incoming>
      <bpmn:outgoing>Flow_ToUrgentEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ToUrgentEnd" sourceRef="Task_UrgentAssessment" targetRef="EndEvent_UrgentHandled" />
    
    <bpmn:serviceTask id="Task_NotifyRejection" name="Notify Patient - Request Rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StaffRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRejected" sourceRef="Task_NotifyRejection" targetRef="EndEvent_Rejected" />
    
    <bpmn:endEvent id="EndEvent_Booked" name="Appointment Booked">
      <bpmn:incoming>Flow_ToBooked</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:endEvent id="EndEvent_UrgentHandled" name="Urgent Case Handled">
      <bpmn:incoming>Flow_ToUrgentEnd</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:endEvent id="EndEvent_Rejected" name="Request Rejected">
      <bpmn:incoming>Flow_ToRejected</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="hospital-appointment-process">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="229" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="162" y="272" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_ValidateRegistration_di" bpmnElement="Task_ValidateRegistration">
        <dc:Bounds x="270" y="207" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_TriageClassification_di" bpmnElement="Task_TriageClassification">
        <dc:Bounds x="430" y="207" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_TriageCategory_di" bpmnElement="Gateway_TriageCategory" isMarkerVisible="true">
        <dc:Bounds x="590" y="222" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="570" y="198" width="91" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_CheckAvailability_di" bpmnElement="Task_CheckAvailability">
        <dc:Bounds x="710" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_AvailabilityCheck_di" bpmnElement="Gateway_AvailabilityCheck" isMarkerVisible="true">
        <dc:Bounds x="870" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="852" y="101" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_StaffReview_di" bpmnElement="Task_StaffReview">
        <dc:Bounds x="710" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_StaffDecision_di" bpmnElement="Gateway_StaffDecision" isMarkerVisible="true">
        <dc:Bounds x="870" y="285" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="852" y="261" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_BookAppointment_di" bpmnElement="Task_BookAppointment">
        <dc:Bounds x="1010" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_NotifyRejection_di" bpmnElement="Task_NotifyRejection">
        <dc:Bounds x="1010" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_UrgentAssessment_di" bpmnElement="Task_UrgentAssessment">
        <dc:Bounds x="710" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_Booked_di" bpmnElement="EndEvent_Booked">
        <dc:Bounds x="1172" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1162" y="175" width="57" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_UrgentHandled_di" bpmnElement="EndEvent_UrgentHandled">
        <dc:Bounds x="872" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="865" y="495" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1172" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1151" y="465" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="215" y="247" />
        <di:waypoint x="270" y="247" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="370" y="247" />
        <di:waypoint x="430" y="247" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="530" y="247" />
        <di:waypoint x="590" y="247" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Routine_di" bpmnElement="Flow_Routine">
        <di:waypoint x="615" y="222" />
        <di:waypoint x="615" y="150" />
        <di:waypoint x="710" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="625" y="133" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_PriorityReview_di" bpmnElement="Flow_PriorityReview">
        <di:waypoint x="615" y="272" />
        <di:waypoint x="615" y="310" />
        <di:waypoint x="710" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="622" y="293" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Urgent_di" bpmnElement="Flow_Urgent">
        <di:waypoint x="615" y="272" />
        <di:waypoint x="615" y="470" />
        <di:waypoint x="710" y="470" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="622" y="453" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="810" y="150" />
        <di:waypoint x="870" y="150" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_SlotsAvailable_di" bpmnElement="Flow_SlotsAvailable">
        <di:waypoint x="920" y="150" />
        <di:waypoint x="1010" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="956" y="133" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_NoSlots_di" bpmnElement="Flow_NoSlots">
        <di:waypoint x="895" y="175" />
        <di:waypoint x="895" y="230" />
        <di:waypoint x="760" y="230" />
        <di:waypoint x="760" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="904" y="213" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_AfterStaffReview_di" bpmnElement="Flow_AfterStaffReview">
        <di:waypoint x="810" y="310" />
        <di:waypoint x="870" y="310" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_StaffApproved_di" bpmnElement="Flow_StaffApproved">
        <di:waypoint x="895" y="285" />
        <di:waypoint x="895" y="220" />
        <di:waypoint x="1060" y="220" />
        <di:waypoint x="1060" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="904" y="203" width="49" height="14" />
        </bpmndi:BPMNLabel>
